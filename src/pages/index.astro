---
import "../styles/global.css";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Today's Shift</title>
    <meta
      name="description"
      content="A daily ordering puzzle: plan one day's tasks in the right order and beat the clock. Same shift for everyone, every day."
    />

    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="app" id="app" data-phase="planning">
      <header class="topbar">
        <p class="brand">Today&rsquo;s Shift</p>
        <nav aria-label="Primary">
          <a href="./">Today</a>
          <a href="./?shift=random">Random</a>
        </nav>
        <p class="streak" id="streak"></p>
      </header>

      <main class="stage">
        <section class="viewport">
          <svg
            class="scene"
            id="scene"
            viewBox="-71 -14 142 102"
            aria-hidden="true"></svg>
        </section>

        <section class="panel">
          <div class="panel-head">
            <p class="eyebrow" id="eyebrow"></p>
            <h1 id="title">Today&rsquo;s Shift</h1>
            <p class="place" id="place"></p>
            <div class="clocks">
              <p><span>Start</span><strong id="start-clock">--:--</strong></p>
              <p>
                <span>Be done by</span><strong id="deadline-clock">--:--</strong>
              </p>
            </div>
            <ul class="constraints" id="constraints"></ul>
          </div>

          <div class="hud" id="hud">
            <p class="hud-clock">
              <strong id="hud-clock">--:--</strong><span id="hud-deadline"></span>
            </p>
            <div class="bar"><span class="bar-fill" id="hud-bar"></span></div>
            <p class="hud-action" id="hud-action"></p>
          </div>

          <div class="result" id="result"></div>

          <ol class="tasks" id="tasks"></ol>
          <button class="commit" id="commit" type="button">
            Start the shift
          </button>
        </section>
      </main>
    </div>

    <script>
      import { mountGame } from "../game/phases";
      mountGame();
    </script>
  </body>
</html>
